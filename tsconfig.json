{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // `allowJs` lets src import the `.mjs` helpers in scripts/. `checkJs` is off: the house now reaches the backend's generated API,
    // which pulls in the shared engine's plain ES5 files (packages/engine/*.js), and those are not written for strict checking.
    // A helper that wants checking says `// @ts-check` at its top.
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src"
  ]
}
