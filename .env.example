# Copy to .env.local (git ignored). Public values only: the development deployment's addresses and one switch (spec 0007).
# The Google and Better Auth secrets live in Convex environment variables, never here.
PUBLIC_CONVEX_URL=https://<your-dev-deployment>.convex.cloud
CONVEX_SITE_URL=https://<your-dev-deployment>.convex.site
# Shows the test email and password form on the Enter screen (/ and /enter). Leave it unset (off) anywhere but your own machine.
VITE_TEST_SIGNIN=true
