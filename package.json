{
  "name": "dhi-house",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "dev:joining": "pnpm --filter dhirise dev",
    "build": "node scripts/with-app-env.mjs vite build",
    "build:all": "pnpm build && pnpm --recursive --workspace-concurrency=1 --if-present --filter \"./apps/*\" --filter \"./packages/*\" run build",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck:house": "tsc --noEmit",
    "typecheck": "pnpm typecheck:house && pnpm --recursive --workspace-concurrency=1 --if-present --filter \"./apps/*\" --filter \"./packages/*\" run typecheck",
    "deploy:house": "node scripts/deploy-house.mjs",
    "enter:check": "node scripts/enter-check.mjs",
    "consent:check": "node scripts/consent-check.mjs",
    "test:house": "node --test \"scripts/**/*.test.mjs\" && node --experimental-strip-types --test src/lib/app-data/app-data.test.ts src/lib/app-data/readiness-schedule.test.ts src/lib/entry.test.ts src/lib/dhi/initials.test.ts src/lib/dhi/class-list.test.ts src/lib/dhi/day-rules.test.ts src/lib/dhi/your-data.test.ts",
    "test": "pnpm test:house && pnpm --recursive --workspace-concurrency=1 --if-present --filter \"./apps/*\" --filter \"./packages/*\" run test",
    "test:e2e": "pnpm --filter dhirise test:e2e",
    "responsive:sweep": "node scripts/responsive-sweep.mjs",
    "look:check": "node scripts/look-check.mjs",
    "lint:house": "eslint src scripts vite.config.ts eslint.config.mjs",
    "lint": "pnpm lint:house && node scripts/check-catalog.mjs && pnpm --recursive --workspace-concurrency=1 --if-present --filter \"./apps/*\" --filter \"./packages/*\" run lint",
    "format": "prettier --write src scripts vite.config.ts eslint.config.mjs",
    "format:check": "prettier --check src scripts vite.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@dhi/backend": "workspace:*",
    "@dhi/engine": "workspace:*",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@hookform/resolvers": "^5.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.0",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.46.0",
    "date-fns": "^4.0.0",
    "lucide-react": "^0.510.0",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "http-proxy-3": "2.0.1",
    "lightningcss": "^1.28.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.56.1",
    "vite": "catalog:",
    "wrangler": "^4.148.0"
  }
}
