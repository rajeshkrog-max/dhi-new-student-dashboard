# Copy to .env.local for local work. Only these public values live here (the apps read PUBLIC_CONVEX_URL and CONVEX_SITE_URL). `CONVEX_DEPLOYMENT` and the Convex CLI live in packages/backend (see its .env.example).
# Public values only here. Secrets go in Convex environment variables, never in this repo (spec 0001).
PUBLIC_CONVEX_URL=
CONVEX_SITE_URL=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
