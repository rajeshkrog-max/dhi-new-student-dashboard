# Copy to .env.local. `pnpm --filter @dhi/backend dev` (convex dev) writes the CONVEX_* lines for you.
# Only this package runs the Convex CLI (spec 0001, child 0002). The apps read PUBLIC_CONVEX_URL and CONVEX_SITE_URL only.
# Public values only. Secrets go in Convex environment variables, never in this repo.
CONVEX_DEPLOYMENT=
